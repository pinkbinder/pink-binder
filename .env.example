# ─── Shared Configuration (used across all apps) ───────────────────────────────
# These variables should be set in .env.local at the root level.
# All Next.js apps in the monorepo will have access to these variables.
# Server-side only by default. Use NEXT_PUBLIC_ prefix for client-side access.

# ─── Marketplace API Keys (server-side only) ──────────────────────────────────
# Required for fetching shop items from various platforms

# Etsy API
ETSY_SHOP_ID=your_etsy_shop_id
ETSY_KEYSTRING=your_etsy_keystring
ETSY_SECRET=your_etsy_secret

# Client ID from your eBay developer keyset (Production).
EBAY_APP_ID=your_ebay_client_id
# Client Secret (Cert ID) from the same keyset — required for OAuth + Browse API.
EBAY_CLIENT_SECRET=your_ebay_cert_id
# Optional alias for EBAY_CLIENT_SECRET.
# EBAY_CERT_ID=your_ebay_cert_id
# Optional: seller username (defaults to thepinkbinder).
# EBAY_SELLER_USERNAME=thepinkbinder
# Optional: keyword used with the sellers filter (defaults to pokemon).
# Put comments on their own line — not after the value (e.g. avoid KEY=value # comment).
# EBAY_SEARCH_QUERY=pokemon
# Server-side only. Used only for the /api/ebay/account-deletion webhook verification route.
EBAY_VERIFICATION_TOKEN=your_ebay_verification_token
# Optional: set to 1 to emit extra server logs for eBay listing fetches.
# In Vercel preview deployments, extra eBay logs are enabled automatically.
# EBAY_DEBUG=1
# Optional: set the exact callback URL registered with eBay for account deletion notifications.
# Use this if the runtime host/protocol can differ from your public endpoint (proxies/CDN).
# EBAY_ACCOUNT_DELETION_ENDPOINT=https://your-domain.com/api/ebay/account-deletion

# ─── Whatnot Scraper Configuration (server-side only) ────────────────────────
# Whatnot username whose scheduled shows should appear across apps.
# Defaults to "thepinkbinder".
# WHATNOT_USERNAME=thepinkbinder

# Override the User-Agent string sent when scraping Whatnot profile page.
# Only change this if Whatnot starts blocking the default UA.
# WHATNOT_USER_AGENT=

# How long (in milliseconds) to cache scraped shows before re-fetching.
# Default: 60000 (60 seconds)
# WHATNOT_SCRAPE_CACHE_TTL_MS=60000

# ─── Custom Shows Endpoint (server-side only, optional) ──────────────────────
# When set, this URL is fetched instead of scraping Whatnot.
# Useful for providing shows data from your own API.
# LIVE_SHOWS_SOURCE_URL=
# LIVE_SHOWS_SOURCE_TOKEN=

# ─── Browser Polling Interval (client-side, requires NEXT_PUBLIC_) ─────────────
# How often (in milliseconds) the browser re-polls /api/shows.
# Default: 60000 (60 seconds). MUST be prefixed with NEXT_PUBLIC_.
# NEXT_PUBLIC_SHOWS_POLL_INTERVAL_MS=60000

# ─── Site URLs (client-side, requires NEXT_PUBLIC_) ────────────────────────────
# Unset in local dev → defaults to localhost (landing :3000, blog :3002).
# Set in Vercel per project for production metadata and cross-app links.
# NEXT_PUBLIC_LANDING_URL=https://pinkbinder.shop
# NEXT_PUBLIC_BLOG_URL=https://pinkbinder.blog
