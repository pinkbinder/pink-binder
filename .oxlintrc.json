{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "off"
  },
  "rules": {
    // Carried over from @typescript-eslint/recommended.
    "typescript/no-explicit-any": "error",
    "typescript/no-require-imports": "error"
  },
  "overrides": [
    {
      "files": ["apps/**", "packages/ui/**"],
      "plugins": ["react"],
      "rules": {
        // Carried over from the ESLint setup: URL/carousel sync-in-effect patterns are intentional.
        "react/set-state-in-effect": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["packages/ui/test/**", "packages/ui/**/*.test.{ts,tsx}"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-unused-vars": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    "**/.wrangler/**",
    "**/dist/**",
    "build/**",
    "coverage/**",
    ".turbo/**",
    "packages/data/cache/**",
    ".github/.code-foundry/**",
    ".github/actions/**"
  ]
}
