{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "ignorePatterns": [
    "CHANGELOG.md",
    ".github/.code-foundry",
    ".github/actions/",
    ".next",
    ".open-next",
    ".wrangler",
    "next-env.d.ts",
    "dist",
    "build",
    "coverage",
    ".turbo",
    "packages/data/cache/",
    "apps/blog/public/data/card-galleries/",
    "apps/blog/public/data/expansion-galleries/",
    "apps/blog/public/_headers"
  ]
}
