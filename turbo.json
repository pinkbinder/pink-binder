{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": ["EBAY_*", "ETSY_*", "WHATNOT_*", "LIVE_SHOWS_*", "BLOG_*", "NEXT_PUBLIC_*"],
  "globalPassThroughEnv": [
    "EBAY_*",
    "ETSY_*",
    "WHATNOT_*",
    "LIVE_SHOWS_*",
    "BLOG_*",
    "NEXT_PUBLIC_*",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        ".env.production",
        ".env.production.local",
        "../../packages/data/cache/normalized/pokemon/**",
        "../../packages/data/cache/normalized/meta/**",
        "../../packages/data/cache/normalized/blogs/**",
        "../../packages/data/cache/normalized/cards/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "EBAY_*",
        "ETSY_*",
        "WHATNOT_*",
        "LIVE_SHOWS_*",
        "BLOG_*",
        "NEXT_PUBLIC_*",
        "POKEMON_CACHE_DIR"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "cache": false
    },
    "format": {},
    "format:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": [".env", ".env.local", ".env.development", ".env.development.local"]
    }
  }
}
