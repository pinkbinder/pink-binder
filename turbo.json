{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": ["EBAY_*", "ETSY_*", "WHATNOT_*", "LIVE_SHOWS_*", "BLOG_*", "PUBLIC_*"],
  "globalPassThroughEnv": [
    "EBAY_*",
    "ETSY_*",
    "WHATNOT_*",
    "LIVE_SHOWS_*",
    "BLOG_*",
    "PUBLIC_*",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        ".env.production",
        ".env.production.local",
        "../../packages/data/cache/normalized/pokemon/**",
        "../../packages/data/cache/normalized/meta/**",
        "../../packages/data/cache/normalized/blogs/**",
        "../../packages/data/cache/normalized/cards/**"
      ],
      "outputs": ["dist/**", ".astro/**"],
      "env": [
        "EBAY_*",
        "ETSY_*",
        "WHATNOT_*",
        "LIVE_SHOWS_*",
        "BLOG_*",
        "PUBLIC_*",
        "POKEMON_CACHE_DIR"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "cache": false
    },
    "format": {},
    "format:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": [".env", ".env.local", ".env.development", ".env.development.local"]
    },
    "cf:build": {
      "dependsOn": [],
      "outputs": [
        "dist/client/_astro/**",
        "dist/client/assets/**",
        "dist/client/_headers",
        "dist/client/.assetsignore",
        "dist/client/.well-known/**",
        "dist/client/**/*.html",
        "dist/client/robots.txt",
        "dist/client/sitemap.xml",
        "dist/server/**"
      ]
    },
    "blog#cf:build": {
      "env": ["CI", "PUBLIC_BLOG_URL"],
      "outputs": [
        "dist/client/_astro/**",
        "dist/client/_headers",
        "dist/client/.assetsignore",
        "dist/client/.well-known/**",
        "dist/client/**/*.html",
        "dist/client/robots.txt",
        "dist/server/**"
      ]
    },
    "landing#cf:build": {
      "env": ["CI"],
      "outputs": [
        "dist/client/_astro/**",
        "dist/client/_headers",
        "dist/client/.assetsignore",
        "dist/client/**/*.html",
        "dist/client/robots.txt",
        "dist/client/sitemap.xml",
        "dist/server/**"
      ]
    },
    "admin#cf:build": {
      "env": ["CI", "PUBLIC_*"],
      "outputs": [
        "dist/client/assets/**",
        "dist/client/_headers",
        "dist/client/.assetsignore",
        "dist/server/**"
      ]
    }
  }
}
