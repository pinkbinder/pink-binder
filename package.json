{
  "name": "pink-binder",
  "private": true,
  "scripts": {
    "build": "node scripts/with-env.mjs turbo run build",
    "dev": "node scripts/kill-dev-ports.mjs && node scripts/with-env.mjs turbo run dev",
    "dev:blog": "node scripts/kill-dev-ports.mjs && node scripts/with-env.mjs turbo run dev --filter=@repo/blog",
    "dev:landing": "node scripts/kill-dev-ports.mjs && node scripts/with-env.mjs turbo run dev --filter=@repo/landing",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "type:check": "turbo run type-check",
    "start": "turbo run start",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "lint-staged": "lint-staged",
    "validate": "node scripts/with-env.mjs turbo run format lint type-check",
    "validate:pre-commit": "node scripts/with-env.mjs turbo run lint type-check",
    "prepare": "husky",
    "format:check": "turbo run format:check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,mdc,css,yml,yaml}": "bunx prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "2.10.5"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "eslint": "^9.39.4",
    "@eslint/js": "^9.39.4",
    "tailwindcss": "^4.3.2"
  }
}
