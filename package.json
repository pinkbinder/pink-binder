{
  "name": "pink-binder",
  "version": "3.6.11",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/with-env.mjs turbo run build --concurrency=1",
    "build:cloudflare": "node scripts/build-cloudflare-worker.mjs",
    "benchmark:routes": "node scripts/benchmark-routes.mjs",
    "performance": "node scripts/check-bundle-budgets.mjs",
    "regression:routes": "node scripts/route-regression.mjs",
    "dev": "node scripts/kill-dev-ports.mjs && node scripts/with-env.mjs turbo run dev",
    "dev:admin": "node scripts/kill-dev-ports.mjs && node scripts/with-env.mjs turbo run dev --filter=@repo/admin",
    "dev:blog": "node scripts/kill-dev-ports.mjs && node scripts/with-env.mjs turbo run dev --filter=@repo/blog",
    "dev:landing": "node scripts/kill-dev-ports.mjs && node scripts/with-env.mjs turbo run dev --filter=@repo/landing",
    "lint": "oxlint . --deny-warnings",
    "type-check": "turbo run type-check",
    "type:check": "turbo run type-check",
    "start": "node scripts/kill-dev-ports.mjs && node scripts/with-env.mjs turbo run dev",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "test": "bun test --isolate",
    "test:unit": "bun run test:coverage",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage --isolate --max-concurrency=4",
    "lint-staged": "lint-staged",
    "validate": "node scripts/with-env.mjs turbo run format type-check && oxlint . --max-warnings 0",
    "validate:pre-commit": "node scripts/with-env.mjs turbo run type-check && oxlint . --max-warnings 0",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-typescript": "^8.0.1",
    "@happy-dom/global-registrator": "^20.14.5",
    "@shadcn/lint": "^0.2.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "^1.4.2",
    "babel-preset-solid": "^1.9.15",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.11.7"
  },
  "overrides": {
    "seroval": "^1.6.3",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.0",
    "source-map-js": "^1.2.2",
    "undici": "^7.29.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --max-warnings 0",
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,mdc,css,yml,yaml}": "oxfmt --write"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "bun@1.4.0"
}
