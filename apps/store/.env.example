# STRIPE_SECRET_KEY=

# Client-side (requires NEXT_PUBLIC_ prefix):
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
# NEXT_PUBLIC_STORE_CURRENCY=USD
