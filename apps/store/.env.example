# ─── Store App Environment Variables ───────────────────────────────────────────
# Inherited from root .env.local:
#   - ETSY_SHOP_ID, ETSY_KEYSTRING, ETSY_SECRET (server-side)
#   - EBAY_APP_ID (server-side)

