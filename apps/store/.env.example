// Store app — Astro on Cloudflare Workers, backed by Medusa (github.com/pinkbinder/medusa).
// Local values live in apps/store/.env.local; deployed values live in the
// Cloudflare Worker dashboard. See repo root `.env.example` for shared keys
// and the medusa repo README for the local backend setup.
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=pk_replace_me
