---
import StoreLayout from '../layouts/StoreLayout.astro'
---

<StoreLayout title="Not found — Pink Binder Store" description="Page not found.">
  <main class="mx-auto max-w-2xl px-4 py-16 text-center">
    <p class="text-sm font-semibold tracking-widest text-pink-500 uppercase">404</p>
    <h1 class="mt-2 text-2xl font-bold">Product not found</h1>
    <p class="text-muted-foreground mt-2">
      The page you are looking for moved or never existed.
    </p>
  </main>
</StoreLayout>
