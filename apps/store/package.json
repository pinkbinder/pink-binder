{
  "name": "@repo/store",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:cloudflare": "astro build",
    "dev": "astro dev --port 3001",
    "lint": "oxlint src astro.config.mjs --max-warnings 0",
    "type-check": "astro check",
    "test": "cd ../.. && bun test apps/store",
    "test:watch": "cd ../.. && bun test --watch apps/store",
    "test:coverage": "cd ../.. && bun test --coverage apps/store",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "start": "astro preview --port 3001",
    "preview": "astro preview --port 3001",
    "deploy": "bun run build:cloudflare && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.0",
    "@astrojs/react": "6.0.5",
    "@medusajs/js-sdk": "^2.1.0",
    "@nanostores/react": "^2.0.1",
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*",
    "astro": "^7.3.1",
    "nanostores": "^1.5.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.130.0"
  }
}
