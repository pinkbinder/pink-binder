{
  "name": "@repo/store",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsr generate && vite build",
    "build:cloudflare": "vite build",
    "dev": "vite dev --port 3001",
    "lint": "cd ../.. && bunx oxlint apps/store/src apps/store/vite.config.ts apps/store/tests --deny-warnings",
    "type-check": "tsr generate && tsc --noEmit",
    "test": "cd ../.. && bun test apps/store",
    "test:watch": "cd ../.. && bun test --watch apps/store",
    "test:coverage": "cd ../.. && bun test --coverage apps/store",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "start": "vite preview --port 3001",
    "preview": "vite preview --port 3001",
    "deploy": "bun run build:cloudflare && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.34",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.51",
    "nuqs": "^2.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.35",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  }
}
