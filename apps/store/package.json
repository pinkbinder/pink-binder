{
  "name": "@repo/store",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:cloudflare": "astro build",
    "dev": "astro dev --port 3001",
    "lint": "oxlint . --max-warnings 0",
    "type-check": "astro check",
    "test": "cd ../.. && bun test apps/store",
    "test:watch": "cd ../.. && bun test --watch apps/store",
    "test:coverage": "cd ../.. && bun test --coverage apps/store",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "start": "astro preview --port 3001",
    "preview": "astro preview --port 3001",
    "deploy": "bun run build:cloudflare && cf-wrangler build && cf deploy --prebuilt",
    "cf-typegen": "wrangler types",
    "cloudflare:build": "astro build && cf-wrangler build && cf deploy --dry-run",
    "deploy:preview": "cf previews deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/solid-js": "^7.0.2",
    "@medusajs/js-sdk": "^2.21.2",
    "@nanostores/solid": "^1.1.1",
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*",
    "astro": "^7.3.5",
    "nanostores": "^1.5.4",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "cf": "^1.0.0-beta.12",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.143.0"
  }
}
