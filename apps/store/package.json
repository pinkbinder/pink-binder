{
  "name": "@repo/store",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:cloudflare": "astro build",
    "dev": "astro dev --port 3001",
    "lint": "oxlint . --max-warnings 0",
    "type-check": "astro check",
    "test": "cd ../.. && bun test apps/store",
    "test:watch": "cd ../.. && bun test --watch apps/store",
    "test:coverage": "cd ../.. && bun test --coverage apps/store",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "start": "astro preview --port 3001",
    "preview": "astro preview --port 3001",
    "deploy": "bun run build:cloudflare && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/solid-js": "^7.0.2",
    "@medusajs/js-sdk": "^2.1.0",
    "@nanostores/solid": "^1.1.1",
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*",
    "astro": "^7.3.2",
    "nanostores": "^1.5.3",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.130.0"
  }
}
