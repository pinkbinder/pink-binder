{
  "name": "@repo/landing",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:cloudflare": "cd ../.. && bunx turbo run cf:build --filter=@repo/landing && bun scripts/restore-cached-media.mjs landing",
    "dev": "astro dev --port 3000",
    "lint": "oxlint . --max-warnings 0",
    "type-check": "astro check",
    "test": "cd ../.. && bun test apps/landing",
    "test:watch": "cd ../.. && bun test --watch apps/landing",
    "test:coverage": "cd ../.. && bun test --coverage apps/landing",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "start": "astro preview --port 3000",
    "cf:build": "astro build",
    "cloudflare:build": "astro build && cf-wrangler build && cf deploy --dry-run",
    "deploy": "bun run build:cloudflare && cf-wrangler build && cf deploy --prebuilt",
    "deploy:preview": "cf previews deploy"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "astro": "7.3.5",
    "cf": "^1.0.0-beta.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.143.0"
  }
}
