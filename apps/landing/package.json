{
  "name": "@repo/landing",
  "version": "0.3.3",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:cloudflare": "bun run --cwd ../.. build:cloudflare -- landing",
    "dev": "next dev --port 3000",
    "dev:webpack": "next dev --port 3000 --webpack",
    "lint": "oxlint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "cd ../.. && bun test apps/landing",
    "test:watch": "cd ../.. && bun test --watch apps/landing",
    "test:coverage": "cd ../.. && bun test --coverage apps/landing",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "start": "next start"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "postcss": "8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.127.1"
  }
}
