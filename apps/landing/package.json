{
  "name": "@repo/landing",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:cloudflare": "astro build",
    "dev": "astro dev --port 3000",
    "lint": "oxlint src astro.config.mjs --max-warnings 0",
    "type-check": "astro check",
    "test": "cd ../.. && bun test apps/landing",
    "test:watch": "cd ../.. && bun test --watch apps/landing",
    "test:coverage": "cd ../.. && bun test --coverage apps/landing",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "start": "astro preview --port 3000"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "astro": "7.3.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.81.0",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.127.1"
  }
}
