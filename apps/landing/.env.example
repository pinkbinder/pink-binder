# ─── Landing App Environment Variables ────────────────────────────────────────
# Inherited from root .env.local:
#   - ETSY_SHOP_ID, ETSY_KEYSTRING, ETSY_SECRET (server-side)
#   - EBAY_APP_ID (server-side)
#   - WHATNOT_USERNAME, WHATNOT_USER_AGENT, WHATNOT_SCRAPE_CACHE_TTL_MS (server-side)
#   - LIVE_SHOWS_SOURCE_URL, LIVE_SHOWS_SOURCE_TOKEN (server-side, optional)
#   - NEXT_PUBLIC_SHOWS_POLL_INTERVAL_MS (client-side, optional)

# ─── Landing App Specific (server-side only) ──────────────────────────────────
# Blog URL for linking from the landing page
# BLOG_URL=http://localhost:3002
