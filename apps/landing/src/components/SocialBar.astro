---
import { SOCIAL_ICON_PATHS, type SocialLink } from '@repo/config'

interface Props {
  socials: SocialLink[]
}

const { socials } = Astro.props as { socials: SocialLink[] }

const iconPaths = SOCIAL_ICON_PATHS
---
<div class="mx-auto flex w-full max-w-[19rem] flex-wrap items-center justify-center gap-3 sm:gap-4" aria-label="Social media links">
  {socials.map((social) => (
    <a
      href={social.href}
      aria-label={social.label}
      target={social.icon !== 'email' ? '_blank' : undefined}
      rel={social.icon !== 'email' ? 'noopener noreferrer' : undefined}
      class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary p-0 text-primary-foreground ring-1 ring-primary/20 transition-colors hover:bg-primary/90 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
    >
      <svg role="img" aria-label={social.label} viewBox="0 0 24 24" fill="currentColor" class="size-7">
        <title>{social.label}</title>
        <path d={iconPaths[social.icon]} />
      </svg>
    </a>
  ))}
</div>
