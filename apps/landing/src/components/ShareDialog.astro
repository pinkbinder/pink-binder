---
import { SHARE_ICON_PATHS, type SharePlatform } from '@repo/config'
const platforms: Array<{ id: SharePlatform; label: string }> = [
  { id: 'facebook', label: 'Share on Facebook' },
  { id: 'messenger', label: 'Share on Messenger' },
  { id: 'x', label: 'Share on X' },
  { id: 'whatsapp', label: 'Share on WhatsApp' },
  { id: 'pinterest', label: 'Share on Pinterest' },
  { id: 'reddit', label: 'Share on Reddit' },
]

const platformPaths = SHARE_ICON_PATHS

---
<dialog
  id="share-dialog"
  aria-labelledby="share-dialog-title"
  class="bg-card text-card-foreground fixed top-1/2 left-1/2 z-50 w-[calc(100%-2rem)] max-w-md -translate-x-1/2 -translate-y-1/2 rounded-2xl border border-pink-200/70 p-5 shadow-xl backdrop:bg-black/40"
>
  <button
    type="button"
    data-share-close
    aria-label="Close share dialog"
    class="ring-offset-background focus:ring-ring absolute top-4 right-4 rounded-full p-1.5 opacity-70 transition-opacity hover:opacity-100 focus:ring-2 focus:ring-offset-2 focus:outline-hidden"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M18 6 6 18M6 6l12 12" />
    </svg>
    <span class="sr-only">Close</span>
  </button>

  <div class="flex flex-col space-y-1.5 pr-6">
    <h2 id="share-dialog-title" class="font-title text-xl leading-none font-semibold tracking-tight">Share link</h2>
    <p id="share-dialog-description" class="text-muted-foreground sr-only text-sm"></p>
  </div>

  <div class="bg-muted mt-4 flex gap-3 rounded-xl p-3">
    <img
      id="share-preview-image"
      src="/images/logo.webp"
      alt=""
      width="56"
      height="56"
      class="h-14 w-14 shrink-0 rounded-lg bg-white object-contain p-1"
    />
    <div class="min-w-0">
      <p id="share-preview-label" class="text-sm font-semibold"></p>
      <p id="share-preview-description" class="text-muted-foreground mt-1 text-xs"></p>
      <p id="share-preview-url" class="text-muted-foreground mt-2 truncate text-xs"></p>
    </div>
  </div>

  <div class="mt-5">
    <p class="text-muted-foreground mb-3 text-xs font-medium tracking-widest uppercase">Share via</p>
    <div class="flex flex-wrap justify-center gap-3">
      {platforms.map((platform) => (
        <div class="flex w-16 flex-col items-center gap-1.5 text-center">
          <button
            type="button"
            data-share-platform={platform.id}
            aria-label={platform.label}
            class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary p-0 text-primary-foreground ring-1 ring-primary/20 transition-colors hover:bg-primary/90 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          >
            <svg role="img" aria-label={platform.label} viewBox="0 0 24 24" fill="currentColor" class="size-5">
              <title>{platform.label}</title>
              <path d={platformPaths[platform.id]} />
            </svg>
          </button>
          <span class="text-muted-foreground text-[10px] font-medium capitalize">
            {platform.id === 'x' ? 'X' : platform.id.charAt(0).toUpperCase() + platform.id.slice(1)}
          </span>
        </div>
      ))}

      <div class="flex w-16 flex-col items-center gap-1.5 text-center">
        <button
          type="button"
          data-share-copy
          aria-label="Copy link"
          class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary p-0 text-primary-foreground ring-1 ring-primary/20 transition-colors hover:bg-primary/90 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          <svg role="img" aria-label="Copy link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
            <title>Copy link</title>
            <rect width="14" height="14" x="8" y="8" rx="2" />
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
          </svg>
        </button>
        <span id="share-copy-label" class="text-muted-foreground text-[10px] font-medium">Copy</span>
      </div>

      <div data-share-native-wrapper class="hidden w-16 flex-col items-center gap-1.5 text-center">
        <button
          type="button"
          data-share-native
          aria-label="More options"
          class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary p-0 text-primary-foreground ring-1 ring-primary/20 transition-colors hover:bg-primary/90 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          <svg role="img" aria-label="More options" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
            <title>More options</title>
            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
            <polyline points="16 6 12 2 8 6" />
            <line x1="12" x2="12" y1="2" y2="15" />
          </svg>
        </button>
        <span class="text-muted-foreground text-[10px] font-medium">More</span>
      </div>
    </div>
  </div>
</dialog>
