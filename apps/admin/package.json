{
  "name": "@repo/admin",
  "version": "0.11.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsr generate && vite build",
    "build:cloudflare": "cd ../.. && bunx turbo run cf:build --filter=@repo/admin && bun scripts/restore-cached-media.mjs admin",
    "dev": "vite dev --port 3003",
    "lint": "oxlint . --max-warnings 0",
    "type-check": "bun check --no-script",
    "test": "cd ../.. && bun test apps/admin",
    "test:watch": "cd ../.. && bun test --watch apps/admin",
    "test:coverage": "cd ../.. && bun test --coverage apps/admin",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "start": "vite preview --port 3003",
    "preview": "vite preview --port 3003",
    "deploy": "bun run build:cloudflare && cf-wrangler build && cf deploy --prebuilt",
    "cf-typegen": "wrangler types",
    "cf:build": "vite build && node scripts/prepare-cloudflare-entry.mjs"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/query-sync-storage-persister": "^5.105.0",
    "@tanstack/solid-query": "^5.105.0",
    "@tanstack/solid-query-persist-client": "^5.105.0",
    "@tanstack/solid-router": "^1.170.43",
    "@tanstack/solid-router-ssr-query": "^1.167.3",
    "@tanstack/solid-start": "^1.169.4",
    "lucide-solid": "^1.64.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^26.5.1",
    "cf": "^1.0.0-beta.25",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.155.0"
  }
}
