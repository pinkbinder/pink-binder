{
  "name": "@repo/admin",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsr generate && vite build",
    "build:cloudflare": "vite build",
    "dev": "vite dev --port 3003",
    "lint": "oxlint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "cd ../.. && bun test apps/admin",
    "test:watch": "cd ../.. && bun test --watch apps/admin",
    "test:coverage": "cd ../.. && bun test --coverage apps/admin",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "start": "vite preview --port 3003",
    "preview": "vite preview --port 3003",
    "deploy": "bun run build:cloudflare && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/query-sync-storage-persister": "^5.102.8",
    "@tanstack/solid-query": "^5.102.8",
    "@tanstack/solid-query-persist-client": "^5.102.8",
    "@tanstack/solid-router": "^1.170.34",
    "@tanstack/solid-router-ssr-query": "^1.167.2",
    "@tanstack/solid-start": "^1.168.51",
    "lucide-solid": "^1.46.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.35",
    "@types/node": "^26.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.130.0"
  }
}
