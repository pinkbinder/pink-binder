---
import Layout from '../../../layouts/Layout.astro'
import MdxProse from '../../../components/MdxProse.astro'
import { POST_PAGE_CACHE_CONTROL, loadPostPageForRequest } from '../../../lib/post-render-r2'

export const prerender = false

const slugParam = Astro.params.slug ?? ''
const slugSegments = Array.isArray(slugParam) ? slugParam : slugParam.split('/').filter(Boolean)

const loaded = await loadPostPageForRequest(slugSegments, Astro.locals)
if (loaded.status === 'not-found') {
  return new Response('Not Found', { status: 404 })
}

// Published articles are immutable; serve them from the CDN edge and purge
// on data publish (see the private data service's publish workflow).
Astro.response.headers.set('Cache-Control', POST_PAGE_CACHE_CONTROL)
const { head } = loaded
---

<Layout
  title={head.title}
  description={head.description}
  canonical={head.canonical}
  image={head.image}
  publishedTime={head.publishedTime}
>
  {
    loaded.status === 'authored' ? (
      <MdxProse content="" />
    ) : (
      <Fragment set:html={loaded.html} />
    )
  }
</Layout>
