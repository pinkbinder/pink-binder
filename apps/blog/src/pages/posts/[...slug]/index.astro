---
import Layout from '../../../layouts/Layout.astro'
import MdxProse from '../../../components/MdxProse.astro'
import { pathSegmentsToCanonicalSlug } from '@repo/data/blog/post-path'
import { getAuthoredPost } from '../../../lib/authored-posts'
import { POST_PAGE_CACHE_CONTROL, loadPostPageForRequest } from '../../../lib/post-render-r2'

export const prerender = false

const slugParam = Astro.params.slug ?? ''
const slugSegments = Array.isArray(slugParam) ? slugParam : slugParam.split('/').filter(Boolean)

const canonicalSlug = pathSegmentsToCanonicalSlug(slugSegments)
const loaded = canonicalSlug
  ? await loadPostPageForRequest(slugSegments, Astro.locals)
  : null

// Authored posts live in `content/*.mdx` and carry no render artifact; they
// backstop the R2 loader both when the artifact reports the authored status
// (no sections, no render) and when no artifact exists at all. An artifact
// claiming `authored` with no committed source still 404s — serving a
// head-only shell reads as a soft 404 to crawlers.
const authored = canonicalSlug ? getAuthoredPost(canonicalSlug) : null

const resolved =
  loaded?.status === 'ok'
    ? { kind: 'prebuilt' as const, head: loaded.head, html: loaded.html }
    : authored
      ? {
          kind: 'authored' as const,
          head: loaded && loaded.status !== 'not-found' ? loaded.head : authored.head,
          body: authored.body,
        }
      : null

if (!resolved) {
  return new Response('Not Found', { status: 404 })
}

// Published articles are immutable; serve them from the CDN edge and purge
// on data publish (see the private data service's publish workflow).
Astro.response.headers.set('Cache-Control', POST_PAGE_CACHE_CONTROL)
const { head } = resolved
---

<Layout
  title={head.title}
  description={head.description}
  canonical={head.canonical}
  image={head.image}
  publishedTime={head.publishedTime}
  postView={{ slug: canonicalSlug ?? '', title: head.title }}
>
  {
    resolved.kind === 'prebuilt' ? (
      <Fragment set:html={resolved.html} />
    ) : (
      <MdxProse content={resolved.body} />
    )
  }
</Layout>
