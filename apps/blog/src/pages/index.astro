---
import Layout from '../layouts/Layout.astro'
import { BlogMainLayout } from '@repo/ui'
import { getSitemapBlogUrl, getSitemapLandingUrl } from '@repo/config'
import { ensureAbsoluteHttpUrl } from '../lib/urls'
import {
  BLOG_INDEX_DESCRIPTION,
  BLOG_INDEX_TITLE,
} from '../lib/blog-metadata'
import {
  buildBlogGridFacets,
  filterBlogGridPosts,
  getPublishedBlogGridPostsForRequest,
} from '../lib/blog-grid-data'
import { resolveBlogGridQuery } from '@repo/ui/blog-query-state'
import { loadBlogFilterSearchParams } from '@repo/ui/blog-query-state/server'
import {
  BLOG_INDEX_INITIAL_COUNT,
  heroStripImageCandidates,
  pokemonR2ImageVariantUrl,
} from '@repo/data/client'
import { BlogGridIsland } from '../components/BlogGridIsland'

// Facet queries re-render per query string; the default view only changes on
// data republish (and deploys purge the zone), so 15 minutes at the edge is
// safe. Vary on Accept: the middleware content-negotiates markdown for agents
// on this path.
const INDEX_CACHE_CONTROL = 'public, max-age=60, s-maxage=900'

const LANDING_URL = ensureAbsoluteHttpUrl(getSitemapLandingUrl())
const BLOG_INDEX_URL = getSitemapBlogUrl()

const rawParams: Record<string, string | string[] | undefined> = {}
Astro.url.searchParams.forEach((value, key) => {
  rawParams[key] = value
})

Astro.response.headers.set('Cache-Control', INDEX_CACHE_CONTROL)
Astro.response.headers.set('Vary', 'Accept')

const [posts, parsedSearchParams] = await Promise.all([
  getPublishedBlogGridPostsForRequest(new Date(), Astro.locals),
  loadBlogFilterSearchParams(rawParams),
])

// Facets stay server-side here: `resolveBlogGridQuery` sanitizes the URL
// against them, and they are no longer passed to the island — the client
// fetches them from /api/posts-grid?facets=1 (see BlogGridIsland).
const facets = buildBlogGridFacets(posts)
const query = resolveBlogGridQuery(parsedSearchParams, facets)
const filteredPosts = filterBlogGridPosts(posts, query)
const initialPosts = filteredPosts.slice(0, BLOG_INDEX_INITIAL_COUNT)

/**
 * The first grid card is the LCP candidate; its image URL is fully known at
 * render time, so preload it at high priority instead of waiting for the
 * island markup to be laid out (mirrors BlogGrid's first-card rendering:
 * hero strip candidates, else the small R2 variant of the post image).
 */
const firstPost = initialPosts[0]
const lcpImageHref = (() => {
  if (!firstPost) return undefined
  if (firstPost.heroArtworkUrls?.length) {
    const candidates = heroStripImageCandidates(firstPost.heroArtworkUrls[0]!)
    const optimized = candidates
      .map((candidate) => pokemonR2ImageVariantUrl(candidate, 'small'))
      .find((url) => url !== null)
    return optimized ?? candidates[0]
  }
  if (!firstPost.image) return undefined
  return pokemonR2ImageVariantUrl(firstPost.image, 'small') ?? firstPost.image
})()

/**
 * Hover-intent prefetch for grid card links: post pages are server-rendered
 * HTML at the edge, so a moderate-eagerness prefetch makes card clicks feel
 * instant without widening the crawl budget (one URL per intent hover).
 */
const speculationRules = {
  prefetch: [
    {
      source: 'document',
      where: { selector_matches: 'article[data-blog-card-index] a[href]' },
      eagerness: 'moderate',
    },
  ],
}
---

<Layout
  title={BLOG_INDEX_TITLE}
  description={BLOG_INDEX_DESCRIPTION}
  canonical={BLOG_INDEX_URL}
  preloadImage={lcpImageHref}
>
  <script is:inline type="speculationrules" set:html={JSON.stringify(speculationRules)} />
  <BlogMainLayout landingUrl={LANDING_URL}>
    <header class="mx-auto max-w-2xl text-center">
      <h1 class="font-title text-4xl font-bold tracking-tight">
        Cute Pokémon Collector Guide
      </h1>
      <p class="text-muted-foreground mt-4 text-base leading-relaxed sm:text-lg">
        Your guide to the soft, pastel, and art-focused side of the Pokémon TCG—featuring regular
        updates on the cutest cards, beautiful illustration styles, set previews, news or
        announcements, and inspiration for your cozy card collection!
      </p>
    </header>
    <BlogGridIsland
      client:interaction
      posts={initialPosts}
      total={filteredPosts.length}
      initialQuery={query}
    />
  </BlogMainLayout>
</Layout>
