---
import { getSitemapBlogUrl, PRODUCTION_BLOG_URL, SOCIAL_LINKS } from '@repo/config'
import { BLOG_SITE_DESCRIPTION, BLOG_SITE_KEYWORDS } from '../lib/blog-metadata'
import { SocialBar } from '@repo/ui/server'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  canonical?: string
  noindex?: boolean
}

const SITE_URL = getSitemapBlogUrl()
const SITE_NAME = 'Pink Binder Blog'
const {
  title = SITE_NAME,
  description = BLOG_SITE_DESCRIPTION,
  canonical = SITE_URL,
  noindex = false,
} = Astro.props as Props

const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`
const socials = SOCIAL_LINKS.filter((s) => s.enabled)
const rssFeeds = [
  { url: new URL('/rss.xml', PRODUCTION_BLOG_URL).toString(), title: 'All posts' },
  { url: new URL('/rss/species.xml', PRODUCTION_BLOG_URL).toString(), title: 'Species guides' },
  {
    url: new URL('/rss/illustrator.xml', PRODUCTION_BLOG_URL).toString(),
    title: 'Illustrator guides',
  },
  {
    url: new URL('/rss/expansion.xml', PRODUCTION_BLOG_URL).toString(),
    title: 'Expansion guides',
  },
  { url: new URL('/rss/roundup.xml', PRODUCTION_BLOG_URL).toString(), title: 'Roundups' },
]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f0a4c8" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={BLOG_SITE_KEYWORDS.join(', ')} />
    <meta name="author" content="Pink Binder" />
    <meta name="creator" content="Pink Binder" />
    <meta name="publisher" content="Pink Binder" />
    <meta name="category" content="blog" />
    {noindex
      ? <meta name="robots" content="noindex" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <link rel="canonical" href={canonical} />
    {rssFeeds.map((feed) => (
      <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.url} />
    ))}
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="service-desc" href="/.well-known/openapi.json" />
    <link rel="service-doc" href="/.well-known/api-docs" />
    <link rel="describedby" href="/.well-known/openapi.json" />
    <link rel="icon" href="/favicon/favicon.ico" />
    <link rel="icon" href="/favicon/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon/android-chrome-192x192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/favicon/android-chrome-512x512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" sizes="180x180" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/images/logo.png', SITE_URL).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL('/images/logo.png', SITE_URL).toString()}
    />
  </head>
  <body class="antialiased">
    <slot />
    <footer class="border-t border-pink-100 px-4 py-8">
      <div class="mx-auto flex max-w-4xl flex-col items-center gap-3">
        <p class="text-primary-deep text-xs font-semibold tracking-[0.3em] uppercase">
          Follow us
        </p>
        <SocialBar socials={socials} />
      </div>
    </footer>
  </body>
</html>
