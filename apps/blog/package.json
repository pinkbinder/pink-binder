{
  "name": "@repo/blog",
  "version": "0.12.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:cloudflare": "astro build",
    "dev": "astro dev --port 3002",
    "lint": "oxlint . --max-warnings 0",
    "type-check": "astro check",
    "test": "cd ../.. && bun test apps/blog",
    "test:watch": "cd ../.. && bun test --watch apps/blog",
    "test:coverage": "cd ../.. && bun test --coverage apps/blog",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "start": "astro preview --port 3002"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/solid-query": "^5.102.8",
    "solid-js": "^1.9.15",
    "web-vitals": "^5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/solid-js": "^7.0.2",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "astro": "7.3.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.81.0",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.127.1"
  }
}
