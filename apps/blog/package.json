{
  "name": "@repo/blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data:expansion-galleries": "node scripts/sync-expansion-gallery-manifests.mjs",
    "prebuild": "pnpm data:expansion-galleries",
    "predev": "pnpm data:expansion-galleries",
    "build": "next build",
    "postbuild": "node scripts/verify-blog-route-trace.mjs",
    "dev": "next dev --port 3002",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run --root ../.. --project blog",
    "test:watch": "vitest --root ../.. --project blog",
    "test:coverage": "vitest run --root ../.. --project blog --coverage --coverage.include='{app,components,lib}/**/*.{ts,tsx}' --coverage.reportsDirectory=coverage/apps-blog --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "start": "next start"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*",
    "next": "16.2.10",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "6.0.3"
  }
}
