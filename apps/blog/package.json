{
  "name": "@repo/blog",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "publish:gallery-manifests": "bun scripts/publish-gallery-manifests.ts",
    "publish:blog-index": "bun scripts/publish-blog-index.ts",
    "publish:blog-posts": "bun scripts/publish-blog-posts.ts",
    "publish:blog-assets": "bun scripts/publish-blog-assets.ts",
    "publish:pokemon-images": "bun scripts/publish-pokemon-image-variants.ts",
    "normalize:r2-image-keys": "bun scripts/normalize-r2-image-keys.ts",
    "build": "next build --webpack",
    "build:cloudflare": "bun run --cwd ../.. build:cloudflare -- blog",
    "postbuild": "node scripts/verify-blog-route-trace.mjs",
    "audit:routes": "node scripts/audit-built-blog.mjs",
    "audit:production": "node scripts/audit-blog-routes.mjs --base-url https://pinkbinder.blog --max-posts 3",
    "dev": "next dev --port 3002",
    "lint": "oxlint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "cd ../.. && bun test apps/blog",
    "test:watch": "cd ../.. && bun test --watch apps/blog",
    "test:coverage": "cd ../.. && bun test --coverage apps/blog",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "start": "next start"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "next": "16.3.4",
    "next-mdx-remote": "^6.0.0",
    "nuqs": "^2.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.984.0",
    "@opennextjs/cloudflare": "1.20.5",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "postcss": "8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.127.1"
  }
}
