{
  "name": "@repo/blog",
  "version": "0.8.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:cloudflare": "astro build",
    "dev": "astro dev --port 3002",
    "lint": "oxlint src astro.config.mjs --max-warnings 0",
    "type-check": "astro check",
    "test": "cd ../.. && bun test apps/blog",
    "test:watch": "cd ../.. && bun test --watch apps/blog",
    "test:coverage": "cd ../.. && bun test --coverage apps/blog",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "start": "astro preview --port 3002"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "nuqs": "^2.10.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.0",
    "@astrojs/react": "6.0.5",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "7.3.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.81.0",
    "postcss": "8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.127.1"
  }
}
