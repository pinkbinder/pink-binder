{
  "name": "@repo/blog",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "data:gallery-manifests": "bun --filter @repo/data build:gallery-manifests && node scripts/sync-gallery-manifests.mjs && node scripts/verify-gallery-manifests.mjs",
    "publish:gallery-manifests": "bun scripts/publish-gallery-manifests.ts",
    "publish:blog-index": "bun scripts/publish-blog-index.ts",
    "publish:blog-posts": "bun scripts/publish-blog-posts.ts",
    "publish:blog-assets": "bun scripts/publish-blog-assets.ts",
    "publish:pokemon-images": "bun scripts/publish-pokemon-image-variants.ts",
    "normalize:r2-image-keys": "bun scripts/normalize-r2-image-keys.ts",
    "prebuild": "bun data:gallery-manifests",
    "predev": "bun data:gallery-manifests",
    "build": "next build",
    "build:cloudflare": "bun run --cwd ../.. build:cloudflare -- blog",
    "postbuild": "node scripts/verify-blog-route-trace.mjs",
    "audit:routes": "node scripts/audit-built-blog.mjs",
    "audit:production": "node scripts/audit-blog-routes.mjs --base-url https://pinkbinder.blog --max-posts 3",
    "dev": "next dev --port 3002",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "cd ../.. && bun test apps/blog",
    "test:watch": "cd ../.. && bun test --watch apps/blog",
    "test:coverage": "cd ../.. && bun test --coverage apps/blog",
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "start": "next start"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@repo/ui": "workspace:*",
    "next": "16.2.12",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.984.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "9.39.5",
    "@opennextjs/cloudflare": "^1.20.4",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.127.1"
  }
}
