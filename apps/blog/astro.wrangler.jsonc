{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "account_id": "e9b73b1b6c312b889732f29b884a5166",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public",
  ],
  "workers_dev": true,
  // Public origins used for in-app links and canonical/SEO URLs. Declared here
  // (not as dashboard secrets) so the values are reviewable and survive a
  // Worker recreation. Read via PUBLIC_* in packages/config/src/site-urls.ts.
  "vars": {
    "PUBLIC_BLOG_URL": "https://pinkbinder.blog",
    "PUBLIC_LANDING_URL": "https://pinkbinder.shop",
  },
  "r2_buckets": [
    {
      "binding": "BLOG_GALLERY_BUCKET",
      "bucket_name": "pink-binder",
    },
  ],
  "dev": {
    "inspector_port": 0,
  },
}
