# ─── Blog App Environment Variables ────────────────────────────────────────────
# Inherited from root .env.local:
#   - ETSY_SHOP_ID, ETSY_KEYSTRING, ETSY_SECRET (server-side)
#   - EBAY_APP_ID (server-side)
#   - NEXT_PUBLIC_SITE_URL (client-side, optional)

# ─── Blog App Specific (server-side only) ─────────────────────────────────────
# Langing page URL for linking from the blog
# LANDING_URL=http://localhost:3000

# BLOG_ANALYTICS_KEY=
# BLOG_CDN_URL=

# ─── Analytics ────────────────────────────────────────────────────────────────
# Google Tag Manager container ID for this app (client-side, requires NEXT_PUBLIC_).
# Obtain from tagmanager.google.com → Admin → Container Settings.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
