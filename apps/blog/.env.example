# Blog app — set local values in apps/blog/.env.local.
# Deployed secrets live in the Cloudflare Worker dashboard.
#
# See repo root `.env.example` for the full variable reference.

# Optional persistent R2 S3 credentials for asset publishing.
# Scope the publishing credentials to the `pink-binder` bucket. Never commit values.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=pink-binder
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
