{
  "name": "@repo/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint src scripts --max-warnings 0",
    "type-check": "tsc --noEmit",
    "format": "prettier --check src scripts package.json tsconfig.json eslint.config.mjs --ignore-path .prettierignore",
    "format:fix": "prettier --write src scripts package.json tsconfig.json eslint.config.mjs --ignore-path .prettierignore",
    "extract": "tsx scripts/1-extract/index.ts",
    "refresh": "tsx scripts/1-extract/extract-periodic.ts",
    "transform": "tsx scripts/2-transform/index.ts",
    "enrich": "tsx scripts/enrich/index.ts",
    "audit-tags": "tsx scripts/audit-collection-tags.ts"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "gray-matter": "^4.0.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@vercel/blob": "^2.3.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.8.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tsx": "^4.22.0",
    "typescript": "6.0.3"
  }
}
