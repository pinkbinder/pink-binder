{
  "name": "@repo/data",
  "version": "2.0.0",
  "private": true,
  "files": [
    "src/**"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./blog/post-path": "./src/blog/post-path.ts",
    "./blog/types/blog-post": "./src/blog/types/blog-post.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint src test --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "cd ../.. && bun test --isolate packages/data",
    "test:watch": "cd ../.. && bun test --watch packages/data",
    "test:coverage": "cd ../.. && bun test --coverage packages/data",
    "format": "oxfmt --check src test package.json tsconfig.json",
    "format:fix": "oxfmt --write src test package.json tsconfig.json"
  },
  "dependencies": {
    "@repo/marketplaces": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.81.0",
    "typescript": "6.0.3"
  }
}
