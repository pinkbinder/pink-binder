{
  "name": "@repo/data",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./card-gallery-server": "./src/blog/card-gallery-server.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src/**",
    "cache/normalized/pokemon/**",
    "cache/normalized/meta/**",
    "cache/normalized/blogs/**",
    "cache/ai/blog-polish/**"
  ],
  "scripts": {
    "lint": "eslint src scripts --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "cd ../.. && bun test packages/data",
    "test:watch": "cd ../.. && bun test --watch packages/data",
    "test:coverage": "cd ../.. && bun test --coverage packages/data",
    "format": "prettier --check src scripts package.json tsconfig.json eslint.config.mjs --ignore-path .prettierignore",
    "format:fix": "prettier --write src scripts package.json tsconfig.json eslint.config.mjs --ignore-path .prettierignore",
    "extract": "tsx scripts/1-extract/index.ts",
    "images": "tsx scripts/2-images/index.ts",
    "transform": "tsx scripts/3-transform/index.ts",
    "full-sync": "bun extract && bun images && bun transform",
    "refresh": "tsx scripts/3-transform/index.ts --only prices",
    "build:gallery-manifests": "tsx scripts/3-transform/5-blog/12-build-gallery-manifests.ts"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "gray-matter": "^4.0.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "9.39.5",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "@vercel/blob": "^2.6.1",
    "eslint": "9.39.5",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "6.0.3"
  }
}
