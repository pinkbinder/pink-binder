{
  "name": "@repo/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "sync-api": "tsx scripts/build-pokemon-data-cache.ts",
    "audit-tags": "tsx scripts/audit-collection-tags.ts",
    "enrich-abilities": "tsx scripts/enrich-ability-descriptions.ts",
    "generate-facts": "tsx scripts/generate-pokemon-facts.ts",
    "enrich-competitive": "tsx scripts/enrich-competitive-snippet.ts",
    "backfill-artwork": "tsx scripts/backfill-artwork-urls.ts",
    "enrich-michi-scene-art": "tsx scripts/enrich-michi-scene-art.ts",
    "enrich-expensive-by-type": "tsx scripts/enrich-expensive-by-type.ts",
    "enrich-artist-tcg-cache": "tsx scripts/enrich-artist-tcg-cache.ts"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "gray-matter": "^4.0.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "eslint": "^9.26.0",
    "prettier": "^3.5.3",
    "typescript": "5.8.3"
  }
}
