{
  "name": "@repo/marketplaces",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./next-images": "./next-images.mjs",
    "./config": "./src/config/index.ts",
    "./ebay": "./src/ebay/index.ts",
    "./etsy": "./src/etsy/index.ts",
    "./tcgplayer": "./src/tcgplayer/index.ts",
    "./whatnot": "./src/whatnot/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "cd ../.. && bun test packages/marketplaces",
    "test:watch": "cd ../.. && bun test --watch packages/marketplaces",
    "test:coverage": "cd ../.. && bun test --coverage packages/marketplaces",
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "9.39.5",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "eslint": "9.39.5",
    "prettier": "^3.9.6",
    "typescript": "6.0.3"
  }
}
