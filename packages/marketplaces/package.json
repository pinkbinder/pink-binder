{
  "name": "@repo/marketplaces",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./next-images": "./next-images.mjs",
    "./config": "./src/config/index.ts",
    "./ebay": "./src/ebay/index.ts",
    "./etsy": "./src/etsy/index.ts",
    "./tcgplayer": "./src/tcgplayer/index.ts",
    "./whatnot": "./src/whatnot/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run --root ../.. --project marketplaces",
    "test:watch": "vitest --root ../.. --project marketplaces",
    "test:coverage": "vitest run --root ../.. --project marketplaces --coverage --coverage.include='src/**/*.ts' --coverage.reportsDirectory=coverage/packages-marketplaces --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.9.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.5",
    "typescript": "6.0.3"
  }
}
