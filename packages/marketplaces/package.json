    "format:fix": "oxfmt --write ."
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "6.0.3"
