{
  "name": "@repo/config",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./site": "./src/site.ts",
    "./security-headers": "./security-headers.mjs",
    "./edge-cache": "./src/edge-cache.ts"
  },
  "scripts": {
    "lint": "oxlint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "cd ../.. && bun test packages/config",
    "test:watch": "cd ../.. && bun test --watch packages/config",
    "test:coverage": "cd ../.. && bun test --coverage packages/config",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write ."
  },
  "dependencies": {
    "@repo/marketplaces": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.81.0",
    "typescript": "6.0.3"
  }
}
