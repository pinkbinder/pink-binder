{
  "name": "@repo/config",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./site": "./src/site.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "cd ../.. && bun test packages/config",
    "test:watch": "cd ../.. && bun test --watch packages/config",
    "test:coverage": "cd ../.. && bun test --coverage packages/config",
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@repo/marketplaces": "workspace:*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "9.39.5",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "eslint": "9.39.5",
    "prettier": "^3.9.6",
    "typescript": "6.0.3"
  }
}
