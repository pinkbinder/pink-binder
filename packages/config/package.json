{
  "name": "@repo/config",
  "version": "1.3.9",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./site": "./src/site.ts",
    "./security-headers": "./security-headers.mjs",
    "./edge-cache": "./src/edge-cache.ts",
    "./query-defaults": "./src/query-defaults.ts"
  },
  "scripts": {
    "lint": "oxlint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "cd ../.. && bun test packages/config",
    "test:watch": "cd ../.. && bun test --watch packages/config",
    "test:coverage": "cd ../.. && bun test --coverage packages/config",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write ."
  },
  "dependencies": {
    "@repo/marketplaces": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^6.0.3"
  }
}
