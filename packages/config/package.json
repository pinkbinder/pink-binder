{
  "name": "@repo/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./site": "./src/site.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run --root ../.. --project config",
    "test:watch": "vitest --root ../.. --project config",
    "test:coverage": "vitest run --root ../.. --project config --coverage --coverage.include='src/**/*.ts' --coverage.reportsDirectory=coverage/packages-config --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@repo/marketplaces": "workspace:*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.8.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "typescript": "6.0.3"
  }
}
