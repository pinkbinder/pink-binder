    "@radix-ui/react-slot": "^1.3.0",
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
