{
  "name": "@repo/ui",
  "version": "2.1.4",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./blog-grid-query": "./src/lib/blog-grid-query.ts",
    "./blog-query-state": "./src/lib/blog-query-state.ts",
    "./blog-query-state/server": "./src/lib/blog-query-state-server.ts",
    "./compat-image": "./src/components/compat-image.tsx",
    "./compat-link": "./src/components/compat-link.tsx",
    "./compat-navigation": "./src/lib/compat-navigation.ts",
    "./format-post-date": "./src/lib/format-post-date.ts",
    "./globals.css": "./src/globals.css",
    "./server": "./src/server.ts",
    "./zaraz-events": "./src/lib/zaraz-events.ts",
    "./accordion": "./src/components/accordion.tsx",
    "./badge": "./src/components/badge.tsx",
    "./button": "./src/components/button.tsx",
    "./card": "./src/components/card.tsx",
    "./dialog": "./src/components/dialog.tsx",
    "./icon-button": "./src/components/icon-button.tsx",
    "./input": "./src/components/input.tsx",
    "./json-ld-script": "./src/components/json-ld-script.tsx",
    "./post-card": "./src/components/post-card.tsx",
    "./pokemon-type-logo": "./src/components/pokemon-type-logo.tsx",
    "./remote-image-with-fallback": "./src/components/remote-image-with-fallback.tsx",
    "./roundup-post-card": "./src/components/roundup-post-card.tsx",
    "./searchable-select": "./src/components/searchable-select.tsx",
    "./select": "./src/components/select.tsx",
    "./separator": "./src/components/separator.tsx"
  },
  "scripts": {
    "lint": "oxlint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "cd ../.. && bun test packages/ui",
    "test:watch": "cd ../.. && bun test --watch packages/ui",
    "test:coverage": "cd ../.. && bun test --coverage packages/ui",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write ."
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@repo/config": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/marketplaces": "workspace:*",
    "@tanstack/solid-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.46.0",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  }
}
